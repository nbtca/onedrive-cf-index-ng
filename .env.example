# Environment Variables for onedrive-cf-index-ng with Logto Integration

# OneDrive Configuration (existing)
USER_PRINCIPLE_NAME=your-email@example.com
BASE_DIRECTORY=/

# Logto Authentication (new - optional)
# Set LOGTO_ENABLED=true to enable Logto authentication
LOGTO_ENABLED=false
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_ENDPOINT=
LOGTO_BASE_URL=
LOGTO_COOKIE_SECRET=

# Example Logto Configuration (uncomment and fill in to use):
# LOGTO_ENABLED=true
# LOGTO_APP_ID=your_logto_app_id_here
# LOGTO_APP_SECRET=your_logto_app_secret_here
# LOGTO_ENDPOINT=https://your-logto-instance.logto.app
# LOGTO_BASE_URL=https://your-domain.com
# LOGTO_COOKIE_SECRET=a_very_complex_secret_at_least_32_characters_long_123456789